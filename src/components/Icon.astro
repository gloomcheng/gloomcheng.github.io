---
// Inline SVG rather than an icon font or CDN set: this page ships as static
// files to Pages, and a network dependency for six glyphs is not worth it.
// All icons are 1em so they align to the text they sit beside.
interface Props { name: string; class?: string }
const { name, class: cls = '' } = Astro.props

const paths: Record<string, string> = {
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"/>',
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>',
  github: '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-1-2.6c3.1-.4 6.4-1.6 6.4-7A5.4 5.4 0 0 0 20 4.8a5 5 0 0 0-.1-3.7s-1.2-.4-4 1.5a13.4 13.4 0 0 0-7 0C6.1.7 4.9 1.1 4.9 1.1a5 5 0 0 0-.1 3.7 5.4 5.4 0 0 0-1.5 3.7c0 5.4 3.3 6.6 6.4 7a3.4 3.4 0 0 0-1 2.6V22"/>',
  scholar: '<path d="M12 3 2 8.5l10 5.5 10-5.5L12 3z"/><path d="M6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/>',
  hf: '<circle cx="12" cy="12" r="9"/><path d="M9 10h.01M15 10h.01M8.5 14.5a5 5 0 0 0 7 0"/>',
  linkedin: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 10v7M7 7v.01M12 17v-4a2 2 0 0 1 4 0v4"/>',
  npm: '<path d="M3 7h18v10H12v-6h-2v6H3V7z"/>',
  drupal: '<path d="M15.1 4.1c-1.4-.8-2.3-1.9-2.9-3.1.1 2.1-1 3.5-2.8 4.4C6.6 6.8 4 8.7 4 12.4A8 8 0 0 0 12 20.5a8 8 0 0 0 8-8.1c0-3.6-2.4-6.4-4.9-8.3z"/><path d="M8.2 15.3c1.1.8 2.3 1.2 3.8 1.2s2.8-.4 3.8-1.2"/>',
  link: '<path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.5-1.5"/>',
  arrow: '<path d="M7 17 17 7M9 7h8v8"/>',
}
---

<svg
  class={cls}
  width="1em" height="1em" viewBox="0 0 24 24" fill="none"
  stroke="currentColor" stroke-width="1.6"
  stroke-linecap="round" stroke-linejoin="round"
  aria-hidden="true" focusable="false"
  set:html={paths[name] ?? ''}
/>
