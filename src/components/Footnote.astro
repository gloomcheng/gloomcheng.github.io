---
const { id, code, title, href, source = "公開來源" } = Astro.props;
const descriptions: Record<string, string> = {
  P01: "2026 年 5 月報導。約八成健檢預約轉為線上、電話值機由三人減為一人；數字限定於該報導描述的導入現場與期間。",
  E14: "2007–2010／旗立資訊責任編輯。編撰國、高中計算機概論教科書。",
  P03: "《看雜誌》第 275 期，2026 年 4 月。報導記錄 FANSEE 從教師與家長市場遇挫，轉向文化館舍合作的過程。",
  "O01–O07":
    "Drupal.org 維護模組、issue credits、React 繁體中文文件與教學倉庫，完整條目列在開源貢獻。",
  "R01–R07":
    "RikaiDev 的 toki、AII、cortex、kaido、mesen、mimamori 與 yomi，完整條目列在 RikaiDev。",
};
---

<button
  type="button"
  popovertarget={id}
  class="ml-1 inline-flex min-h-6 min-w-6 cursor-pointer items-center justify-center border-0 bg-transparent p-0 align-super font-sans text-xs leading-none font-extrabold text-seed-orange focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-seed-orange"
  aria-label={`開啟註解 ${code}`}>{code}</button
>
<span
  id={id}
  popover
  class="m-auto max-h-[80svh] w-[min(92vw,560px)] overflow-auto border-0 bg-seed-paper p-0 text-seed-ink shadow-2xl backdrop:bg-seed-ink/55"
>
  <span class="block border-t-8 border-seed-orange p-6 md:p-8">
    <span class="mb-5 flex items-start justify-between gap-6"
      ><span class="block"
        ><span class="block text-xs font-bold tracking-wider text-seed-orange"
          >{code}／{source}</span
        ><span class="mt-2 block font-display text-2xl leading-8 font-bold"
          >{title}</span
        ></span
      ><button
        type="button"
        popovertarget={id}
        popovertargetaction="hide"
        class="flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full border border-seed-ink bg-transparent font-sans text-2xl leading-none transition-colors hover:bg-seed-ink hover:text-seed-paper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-seed-orange"
        aria-label="關閉註解"><span aria-hidden="true">×</span></button
      ></span
    >
    <span class="block text-base leading-8">{descriptions[code]}</span>
    {
      href && (
        <a
          class="mt-5 inline-block text-xs font-extrabold underline underline-offset-4"
          href={href}
        >
          查看完整資料 ↗
        </a>
      )
    }
  </span>
</span>
