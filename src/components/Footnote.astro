---
import { footnotes, type FootnoteCode } from '../data/footnotes'

interface Props {
  code: FootnoteCode
}

const { code }: Props = Astro.props
const note = footnotes[code]
---

<sup class="footnote-ref">
  <a
    id={`ref-${code}`}
    href={`#footnote-${code}`}
    aria-label={`查看註解 ${code}：${note.title}`}
  >{code}</a>
</sup>
