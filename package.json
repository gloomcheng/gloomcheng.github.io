{
  "name": "gloomcheng-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "biome lint src --error-on-warnings",
    "format": "biome format src --write",
    "harness": "node scripts/harness.mjs",
    "import:tayanswa": "node scripts/import-tayanswa.mjs",
    "rig:seed-beast": "node scripts/build-seed-beast-rig.mjs",
    "fonts:subset": "node scripts/subset-fonts.mjs",
    "check": "bun run typecheck && bun run rig:seed-beast && bun run lint && bun run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "astro": "7.2.7",
    "tailwindcss": "^4.0.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sanitize-html": "^2.17.7",
    "typescript": "^6.0.0"
  }
}
